          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT me.executed_at AS time, m.name AS monitor, m.method, m.url, me.status, me.status_code, me.response_time_ms AS latency_ms, COALESCE(me.error_message, '-') AS error_detail FROM monitor_executions me JOIN monitors m ON me.monitor_id = m.id WHERE $__timeFilter(me.executed_at) AND ('$monitor' = 'All' OR me.monitor_id = '$monitor') ORDER BY me.executed_at DESC LIMIT 50;",
          "refId": "A"
        }
