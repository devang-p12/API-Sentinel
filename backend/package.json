  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "npx prisma db push --skip-generate --accept-data-loss && node dist/main",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "test:multitenant": "npx ts-node test/phase1-multitenant.spec.ts",
    "test:phase2": "npx ts-node test/phase2-apis-environments.spec.ts",
    "test:phase3": "npx ts-node test/phase3-request-execution.spec.ts",
    "test:phase4": "npx ts-node test/phase4-agentless-monitoring.spec.ts",
    "test:phase5": "npx ts-node test/phase5-health-evaluation.spec.ts",
    "test:phase6": "npx ts-node test/phase6-reliability-score.spec.ts",
    "test:phase7": "npx ts-node test/phase7-schema-monitoring.spec.ts",
    "test:phase8": "npx ts-node test/phase8-incident-management.spec.ts",
    "test:phase9": "npx ts-node test/phase9-alert-management.spec.ts",
    "test:phase10": "npx ts-node test/phase10-customer-dashboard.spec.ts",
    "test:phase11": "npx ts-node test/phase11-api-details.spec.ts",
    "test:phase12": "npx ts-node test/phase12-prometheus-metrics.spec.ts",
    "test:phase13": "npx ts-node test/phase13-internal-grafana.spec.ts",
    "test:all": "npm run test:multitenant && npm run test:phase2 && npm run test:phase3 && npm run test:phase4 && npm run test:phase5 && npm run test:phase6 && npm run test:phase7 && npm run test:phase8 && npm run test:phase9 && npm run test:phase10 && npm run test:phase11 && npm run test:phase12 && npm run test:phase13"
  },
  "dependencies": {
    "@nestjs/common": "^10.3.8",
    "@nestjs/config": "^3.2.2",
    "@nestjs/core": "^10.3.8",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/passport": "^10.0.3",
    "@nestjs/platform-express": "^10.3.8",
    "@prisma/client": "^5.14.0",
    "bcryptjs": "^3.0.3",
    "bullmq": "^5.7.11",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "ioredis": "^5.4.1",
    "nodemailer": "^10.3.1",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.2",
    "resend": "^6.37.0",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
