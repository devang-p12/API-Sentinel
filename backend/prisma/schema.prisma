datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// -------------------------------------------------------------
// ENUMS
// -------------------------------------------------------------

enum UserRole {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

enum HttpMethod {
  GET
  POST
  PUT
  PATCH
  DELETE
  HEAD
  OPTIONS
}

enum ExecutionStatus {
  SUCCESS
  FAILED
  TIMEOUT
  ERROR
}

enum IncidentStatus {
  TRIGGERED
  ACKNOWLEDGED
  RESOLVED
}

enum AlertSeverity {
  INFO
  WARNING
  CRITICAL
}

// -------------------------------------------------------------
// DOMAIN MODELS
// -------------------------------------------------------------

model Organization {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  users    User[]
  projects Project[]

  @@map("organizations")
}

model User {
  id             String       @id @default(uuid())
  email          String       @unique
  passwordHash   String       @map("password_hash")
  firstName      String       @map("first_name")
  lastName       String       @map("last_name")
  role           UserRole     @default(MEMBER)
  organizationId String       @map("organization_id")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  @@index([organizationId])
  @@map("users")
}

model Project {
  id             String       @id @default(uuid())
  name           String
  description    String?
  organizationId String       @map("organization_id")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  apis Api[]

  @@unique([organizationId, name])
  @@index([organizationId])
  @@map("projects")
}

model Api {
  id          String   @id @default(uuid())
  name        String
  description String?
  projectId   String   @map("project_id")
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  environments Environment[]

  @@unique([projectId, name])
  @@index([projectId])
  @@map("apis")
}

model Environment {
  id          String   @id @default(uuid())
  name        String   // e.g. "production", "staging", "development"
  baseUrl     String?  @map("base_url") // e.g. "http://localhost:4000"
  variables   Json?    @default("{}") // Environment-level headers/auth tokens
  apiId       String   @map("api_id")
  api         Api      @relation(fields: [apiId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  monitors Monitor[]

  @@unique([apiId, name])
  @@index([apiId])
  @@map("environments")
}

model Monitor {
  id              String     @id @default(uuid())
  name            String
  description     String?
  method          HttpMethod @default(GET)
  url             String     // Path (e.g. "/healthy") or full URL
  headers         Json?      @default("{}") // Request headers
  body            String?    // Request payload (for POST/PUT)
  intervalSeconds Int        @default(60) @map("interval_seconds") // Frequency
  timeoutMs       Int        @default(10000) @map("timeout_ms") // Max wait time
  isActive        Boolean    @default(true) @map("is_active")
  
  // Assertions: e.g. [{ "type": "statusCode", "operator": "equals", "value": 200 }]
  assertions      Json?      @default("[]")

  environmentId   String      @map("environment_id")
  environment     Environment @relation(fields: [environmentId], references: [id], onDelete: Cascade)

  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")

  executions MonitorExecution[]
  alerts     Alert[]

  @@index([environmentId])
  @@index([isActive])
  @@map("monitors")
}

model MonitorExecution {
  id               String          @id @default(uuid())
  monitorId        String          @map("monitor_id")
  monitor          Monitor         @relation(fields: [monitorId], references: [id], onDelete: Cascade)
  status           ExecutionStatus
  statusCode       Int?            @map("status_code") // null if network timeout/DNS failure
  responseTimeMs   Int             @map("response_time_ms")
  responseSize     Int?            @map("response_size") // bytes
  responseHeaders  Json?           @map("response_headers")
  assertionResults Json?           @map("assertion_results") // breakdown of what passed/failed
  errorMessage     String?         @map("error_message")
  executedAt       DateTime        @default(now()) @map("executed_at")

  @@index([monitorId, executedAt(sort: Desc)])
  @@index([executedAt(sort: Desc)])
  @@map("monitor_executions")
}

model Alert {
  id             String        @id @default(uuid())
  name           String
  severity       AlertSeverity @default(WARNING)
  condition      Json
  isEnabled      Boolean       @default(true) @map("is_enabled")
  monitorId      String        @map("monitor_id")
  monitor        Monitor       @relation(fields: [monitorId], references: [id], onDelete: Cascade)
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  incidents Incident[]

  @@index([monitorId])
  @@map("alerts")
}

model Incident {
  id           String         @id @default(uuid())
  status       IncidentStatus @default(TRIGGERED)
  summary      String
  startedAt    DateTime       @default(now()) @map("started_at")
  resolvedAt   DateTime?      @map("resolved_at")
  alertId      String         @map("alert_id")
  alert        Alert          @relation(fields: [alertId], references: [id], onDelete: Cascade)

  @@index([alertId, status])
  @@map("incidents")
}
