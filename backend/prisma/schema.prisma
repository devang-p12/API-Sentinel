datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// -------------------------------------------------------------
// ENUMS
// -------------------------------------------------------------

enum UserRole {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

enum HttpMethod {
  GET
  POST
  PUT
  PATCH
  DELETE
  HEAD
  OPTIONS
}

enum ExecutionStatus {
  SUCCESS
  FAILED
  TIMEOUT
  ERROR
}

enum IncidentStatus {
  OPEN
  ACKNOWLEDGED
  RESOLVED
}

enum IncidentEventType {
  CREATED
  ALERT_ATTACHED
  ALERT_RESOLVED
  ACKNOWLEDGED
  SEVERITY_CHANGED
  RESOLVED
}

enum ActorType {
  SYSTEM
  USER
}

enum AlertSeverity {
  INFO
  WARNING
  HIGH
  CRITICAL
}

enum AlertCondition {
  GREATER_THAN
  GREATER_THAN_OR_EQUAL
  LESS_THAN
  LESS_THAN_OR_EQUAL
  EQUAL
  NOT_EQUAL
}

enum AlertState {
  NORMAL
  PENDING
  FIRING
  RESOLVED
}

enum LoadTestStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
}

enum LoadTestMode {
  DURATION
  REQUEST_COUNT
}

// -------------------------------------------------------------
// DOMAIN MODELS
// -------------------------------------------------------------

model Organization {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  users                User[]
  projects             Project[]
  contactPoints        ContactPoint[]
  notificationPolicies NotificationPolicy[]
  notificationSilences NotificationSilence[]

  @@map("organizations")
}

model User {
  id             String       @id @default(uuid())
  email          String       @unique
  passwordHash   String       @map("password_hash")
  firstName      String       @map("first_name")
  lastName       String       @map("last_name")
  role           UserRole     @default(MEMBER)
  organizationId String       @map("organization_id")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  @@index([organizationId])
  @@map("users")
}

model Project {
  id             String       @id @default(uuid())
  name           String
  description    String?
  organizationId String       @map("organization_id")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  apis             Api[]
  dashboards       Dashboard[]
  alertRules       AlertRule[]
  incidents        Incident[]
  loadTests        LoadTest[]
  apiCollections   ApiCollection[]
  savedRequests    SavedApiRequest[]
  requestHistories ApiRequestHistory[]

  @@unique([organizationId, name])
  @@index([organizationId])
  @@map("projects")
}

model Api {
  id          String   @id @default(uuid())
  name        String
  description String?
  projectId   String   @map("project_id")
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  environments     Environment[]
  alertRules       AlertRule[]
  incidents        Incident[]
  loadTests        LoadTest[]
  savedRequests    SavedApiRequest[]
  requestHistories ApiRequestHistory[]

  @@unique([projectId, name])
  @@index([projectId])
  @@map("apis")
}

model Environment {
  id        String   @id @default(uuid())
  name      String // e.g. "production", "staging", "development"
  baseUrl   String?  @map("base_url") // e.g. "http://localhost:4000"
  variables Json?    @default("{}") // Environment-level headers/auth tokens
  apiId     String   @map("api_id")
  api       Api      @relation(fields: [apiId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  monitors         Monitor[]
  alertRules       AlertRule[]
  incidents        Incident[]
  loadTests        LoadTest[]
  savedRequests    SavedApiRequest[]
  requestHistories ApiRequestHistory[]

  @@unique([apiId, name])
  @@index([apiId])
  @@map("environments")
}

model Monitor {
  id              String     @id @default(uuid())
  name            String
  description     String?
  method          HttpMethod @default(GET)
  url             String // Path (e.g. "/healthy") or full URL
  headers         Json?      @default("{}") // Request headers
  body            String? // Request payload (for POST/PUT)
  intervalSeconds Int        @default(60) @map("interval_seconds") // Frequency
  timeoutMs       Int        @default(10000) @map("timeout_ms") // Max wait time
  isActive        Boolean    @default(true) @map("is_active")

  // Assertions: e.g. [{ "type": "statusCode", "operator": "equals", "value": 200 }]
  assertions Json? @default("[]")

  environmentId String      @map("environment_id")
  environment   Environment @relation(fields: [environmentId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  executions MonitorExecution[]
  alerts     Alert[]
  alertRules AlertRule[]

  @@index([environmentId])
  @@index([isActive])
  @@map("monitors")
}

model MonitorExecution {
  id               String          @id @default(uuid())
  monitorId        String          @map("monitor_id")
  monitor          Monitor         @relation(fields: [monitorId], references: [id], onDelete: Cascade)
  status           ExecutionStatus
  statusCode       Int?            @map("status_code") // null if network timeout/DNS failure
  responseTimeMs   Int             @map("response_time_ms")
  responseSize     Int?            @map("response_size") // bytes
  responseHeaders  Json?           @map("response_headers")
  assertionResults Json?           @map("assertion_results") // breakdown of what passed/failed
  errorMessage     String?         @map("error_message")
  executedAt       DateTime        @default(now()) @map("executed_at")

  @@index([monitorId, executedAt(sort: Desc)])
  @@index([executedAt(sort: Desc)])
  @@map("monitor_executions")
}

model Alert {
  id        String        @id @default(uuid())
  name      String
  severity  AlertSeverity @default(WARNING)
  condition Json
  isEnabled Boolean       @default(true) @map("is_enabled")
  monitorId String        @map("monitor_id")
  monitor   Monitor       @relation(fields: [monitorId], references: [id], onDelete: Cascade)
  createdAt DateTime      @default(now()) @map("created_at")
  updatedAt DateTime      @updatedAt @map("updated_at")

  @@index([monitorId])
  @@map("alerts")
}

model Incident {
  id            String         @id @default(uuid())
  projectId     String         @map("project_id")
  project       Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title         String
  description   String?
  status        IncidentStatus @default(OPEN)
  severity      AlertSeverity  @default(WARNING)
  apiId         String?        @map("api_id")
  api           Api?           @relation(fields: [apiId], references: [id], onDelete: SetNull)
  environmentId String?        @map("environment_id")
  environment   Environment?   @relation(fields: [environmentId], references: [id], onDelete: SetNull)

  startedAt      DateTime  @default(now()) @map("started_at")
  acknowledgedAt DateTime? @map("acknowledged_at")
  resolvedAt     DateTime? @map("resolved_at")
  acknowledgedBy String?   @map("acknowledged_by")
  resolvedBy     String?   @map("resolved_by")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  alerts     IncidentAlert[]
  events     IncidentEvent[]
  deliveries NotificationDelivery[]

  @@index([projectId, status])
  @@index([apiId, environmentId, status])
  @@index([status])
  @@index([startedAt(sort: Desc)])
  @@map("incidents")
}

model IncidentAlert {
  id              String        @id @default(uuid())
  incidentId      String        @map("incident_id")
  incident        Incident      @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  alertInstanceId String        @map("alert_instance_id")
  alertInstance   AlertInstance @relation(fields: [alertInstanceId], references: [id], onDelete: Cascade)
  createdAt       DateTime      @default(now()) @map("created_at")

  @@unique([incidentId, alertInstanceId])
  @@index([incidentId])
  @@index([alertInstanceId])
  @@map("incident_alerts")
}

model IncidentEvent {
  id         String            @id @default(uuid())
  incidentId String            @map("incident_id")
  incident   Incident          @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  type       IncidentEventType
  message    String
  actorType  ActorType         @default(SYSTEM) @map("actor_type")
  actorId    String?           @map("actor_id")
  metadata   Json?             @default("{}")
  createdAt  DateTime          @default(now()) @map("created_at")

  @@index([incidentId, createdAt])
  @@map("incident_events")
}

model Dashboard {
  id          String   @id @default(uuid())
  name        String
  description String?
  projectId   String   @map("project_id")
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  layout      Json?    @default("[]") // Global layout metadata or widget order
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  widgets DashboardWidget[]

  @@unique([projectId, name])
  @@index([projectId])
  @@map("dashboards")
}

model DashboardWidget {
  id                String    @id @default(uuid())
  dashboardId       String    @map("dashboard_id")
  dashboard         Dashboard @relation(fields: [dashboardId], references: [id], onDelete: Cascade)
  title             String
  metric            String // Stable metric key, e.g. "p95_latency", "availability"
  visualizationType String    @map("visualization_type") // "stat", "time_series", "bar", "table", "gauge"
  configuration     Json      @default("{}") // filters: { apiId, environmentId, monitorId }, aggregation, etc.

  // Grid layout positioning
  x      Int @default(0)
  y      Int @default(0)
  width  Int @default(6) // 1-12 columns
  height Int @default(3) // grid rows

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([dashboardId])
  @@map("dashboard_widgets")
}

model AlertRule {
  id                 String         @id @default(uuid())
  name               String
  description        String?
  projectId          String         @map("project_id")
  project            Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  metric             String // e.g. "p95_latency", "error_rate", "availability"
  apiId              String?        @map("api_id")
  api                Api?           @relation(fields: [apiId], references: [id], onDelete: SetNull)
  environmentId      String?        @map("environment_id")
  environment        Environment?   @relation(fields: [environmentId], references: [id], onDelete: SetNull)
  monitorId          String?        @map("monitor_id")
  monitor            Monitor?       @relation(fields: [monitorId], references: [id], onDelete: SetNull)
  condition          AlertCondition
  threshold          Float
  duration           Int            @default(0) // FOR duration in seconds (0 = immediate)
  evaluationInterval Int            @default(60) @map("evaluation_interval") // in seconds
  severity           AlertSeverity  @default(WARNING)
  labels             Json?          @default("{}") // e.g. { team: "backend", service: "payments" }
  notificationConfig Json?          @default("{}") @map("notification_config")
  enabled            Boolean        @default(true)
  createdBy          String?        @map("created_by")
  createdAt          DateTime       @default(now()) @map("created_at")
  updatedAt          DateTime       @updatedAt @map("updated_at")

  instances   AlertInstance[]
  evaluations AlertEvaluation[]
  deliveries  NotificationDelivery[]

  @@index([projectId, enabled])
  @@index([metric])
  @@index([apiId])
  @@index([environmentId])
  @@index([monitorId])
  @@map("alert_rules")
}

model AlertInstance {
  id              String     @id @default(uuid())
  alertRuleId     String     @map("alert_rule_id")
  alertRule       AlertRule  @relation(fields: [alertRuleId], references: [id], onDelete: Cascade)
  fingerprint     String
  status          AlertState @default(NORMAL)
  currentValue    Float?     @map("current_value")
  threshold       Float
  pendingSince    DateTime?  @map("pending_since")
  startedAt       DateTime?  @map("started_at")
  lastEvaluatedAt DateTime   @default(now()) @map("last_evaluated_at")
  resolvedAt      DateTime?  @map("resolved_at")
  createdAt       DateTime   @default(now()) @map("created_at")
  updatedAt       DateTime   @updatedAt @map("updated_at")

  evaluations    AlertEvaluation[]
  incidentAlerts IncidentAlert[]
  deliveries     NotificationDelivery[]

  @@index([alertRuleId, status])
  @@index([fingerprint])
  @@index([status])
  @@index([startedAt])
  @@map("alert_instances")
}

model AlertEvaluation {
  id              String         @id @default(uuid())
  alertRuleId     String         @map("alert_rule_id")
  alertRule       AlertRule      @relation(fields: [alertRuleId], references: [id], onDelete: Cascade)
  alertInstanceId String?        @map("alert_instance_id")
  alertInstance   AlertInstance? @relation(fields: [alertInstanceId], references: [id], onDelete: Cascade)
  value           Float?
  threshold       Float
  conditionMet    Boolean        @map("condition_met")
  stateBefore     AlertState     @map("state_before")
  stateAfter      AlertState     @map("state_after")
  evaluatedAt     DateTime       @default(now()) @map("evaluated_at")

  @@index([alertInstanceId, evaluatedAt])
  @@index([alertRuleId, evaluatedAt])
  @@map("alert_evaluations")
}

// -------------------------------------------------------------
// PHASE 6: NOTIFICATION & ALERT ROUTING MODELS
// -------------------------------------------------------------

enum ContactPointType {
  EMAIL
  SLACK
  WEBHOOK
}

enum NotificationDeliveryStatus {
  PENDING
  SENDING
  SENT
  FAILED
  CANCELLED
}

enum NotificationEventType {
  FIRING
  RECOVERY
  REPEAT
  TEST
}

model ContactPoint {
  id             String           @id @default(uuid())
  organizationId String           @map("organization_id")
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  type           ContactPointType
  configuration  Json
  isEnabled      Boolean          @default(true) @map("is_enabled")
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")

  deliveries NotificationDelivery[]

  @@unique([organizationId, name])
  @@index([organizationId])
  @@map("contact_points")
}

model NotificationPolicy {
  id               String       @id @default(uuid())
  organizationId   String       @map("organization_id")
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name             String
  description      String?
  isEnabled        Boolean      @default(true) @map("is_enabled")
  priority         Int          @default(100)
  matchers         Json         @default("[]")
  contactPointIds  Json         @default("[]")
  notifyOnFiring   Boolean      @default(true) @map("notify_on_firing")
  notifyOnRecovery Boolean      @default(true) @map("notify_on_recovery")
  repeatInterval   Int          @default(0) @map("repeat_interval")
  createdAt        DateTime     @default(now()) @map("created_at")
  updatedAt        DateTime     @updatedAt @map("updated_at")

  deliveries NotificationDelivery[]

  @@index([organizationId, isEnabled])
  @@map("notification_policies")
}

model NotificationDelivery {
  id               String                     @id @default(uuid())
  organizationId   String                     @map("organization_id")
  incidentId       String?                    @map("incident_id")
  incident         Incident?                  @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  alertInstanceId  String?                    @map("alert_instance_id")
  alertInstance    AlertInstance?             @relation(fields: [alertInstanceId], references: [id], onDelete: SetNull)
  alertRuleId      String?                    @map("alert_rule_id")
  alertRule        AlertRule?                 @relation(fields: [alertRuleId], references: [id], onDelete: SetNull)
  contactPointId   String?                    @map("contact_point_id")
  contactPoint     ContactPoint?              @relation(fields: [contactPointId], references: [id], onDelete: Cascade)
  recipient        String?                    @map("recipient")
  channel          ContactPointType           @default(EMAIL)
  policyId         String?                    @map("policy_id")
  policy           NotificationPolicy?        @relation(fields: [policyId], references: [id], onDelete: SetNull)
  eventType        NotificationEventType      @map("event_type")
  status           NotificationDeliveryStatus @default(PENDING)
  attemptCount     Int                        @default(0) @map("attempt_count")
  lastAttemptAt    DateTime?                  @map("last_attempt_at")
  nextRetryAt      DateTime?                  @map("next_retry_at")
  errorMessage     String?                    @map("error_message")
  deduplicationKey String                     @unique @map("deduplication_key")
  payload          Json?                      @default("{}")
  sentAt           DateTime?                  @map("sent_at")
  createdAt        DateTime                   @default(now()) @map("created_at")
  updatedAt        DateTime                   @updatedAt @map("updated_at")

  @@index([incidentId])
  @@index([alertRuleId])
  @@index([status])
  @@index([contactPointId])
  @@index([policyId])
  @@index([createdAt(sort: Desc)])
  @@map("notification_deliveries")
}

model NotificationSilence {
  id             String       @id @default(uuid())
  organizationId String       @map("organization_id")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy      String?      @map("created_by")
  matchers       Json         @default("[]")
  startsAt       DateTime     @map("starts_at")
  endsAt         DateTime     @map("ends_at")
  reason         String?
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  @@index([organizationId, startsAt, endsAt])
  @@map("notification_silences")
}

// -------------------------------------------------------------
// LOAD TESTING MODELS
// -------------------------------------------------------------

model LoadTest {
  id             String         @id @default(uuid())
  name           String
  description    String?
  projectId      String         @map("project_id")
  project        Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  apiId          String?        @map("api_id")
  api            Api?           @relation(fields: [apiId], references: [id], onDelete: SetNull)
  environmentId  String?        @map("environment_id")
  environment    Environment?   @relation(fields: [environmentId], references: [id], onDelete: SetNull)
  createdBy      String?        @map("created_by")

  method         HttpMethod     @default(GET)
  url            String         // path (e.g. "/delay/2") or full URL
  headers        Json?          @default("{}")
  queryParams    Json?          @default("{}")
  body           String?        // Request payload for POST/PUT/PATCH
  authentication Json?          @default("{}")

  virtualUsers   Int            @default(10) @map("virtual_users")
  duration       Int?           @default(60) // in seconds, used if mode == DURATION
  requestCount   Int?           @map("request_count") // total requests, used if mode == REQUEST_COUNT
  mode           LoadTestMode   @default(DURATION)
  timeout        Int            @default(5) // in seconds

  status         LoadTestStatus @default(QUEUED)
  errorMessage   String?        @map("error_message")

  startedAt      DateTime?      @map("started_at")
  completedAt    DateTime?      @map("completed_at")
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")

  result         LoadTestResult?
  samples        LoadTestSample[]

  @@index([projectId, status])
  @@index([apiId, environmentId])
  @@index([status])
  @@index([createdAt(sort: Desc)])
  @@map("load_tests")
}

model LoadTestResult {
  id                    String    @id @default(uuid())
  loadTestId            String    @unique @map("load_test_id")
  loadTest              LoadTest  @relation(fields: [loadTestId], references: [id], onDelete: Cascade)

  totalRequests         Int       @map("total_requests")
  successfulRequests    Int       @map("successful_requests")
  failedRequests        Int       @map("failed_requests")
  requestsPerSecond     Float     @map("requests_per_second")
  actualDurationSeconds Float     @map("actual_duration_seconds")

  avgLatency            Float     @map("avg_latency")
  minLatency            Float     @map("min_latency")
  maxLatency            Float     @map("max_latency")
  p50Latency            Float     @map("p50_latency")
  p90Latency            Float     @map("p90_latency")
  p95Latency            Float     @map("p95_latency")
  p99Latency            Float     @map("p99_latency")

  errorRate             Float     @map("error_rate")
  timeoutCount          Int       @default(0) @map("timeout_count")
  connectionErrors      Int       @default(0) @map("connection_errors")

  statusCodeCounts      Json      @default("{}") @map("status_code_counts")
  errorBreakdown        Json?     @default("{}") @map("error_breakdown")

  createdAt             DateTime  @default(now()) @map("created_at")

  @@map("load_test_results")
}

model LoadTestSample {
  id                 String    @id @default(uuid())
  loadTestId         String    @map("load_test_id")
  loadTest           LoadTest  @relation(fields: [loadTestId], references: [id], onDelete: Cascade)

  timestamp          DateTime
  relativeSeconds    Int       @map("relative_seconds")
  requestsPerSecond  Float     @map("requests_per_second")
  activeUsers        Int       @default(0) @map("active_users")
  avgLatency         Float     @map("avg_latency")
  p50Latency         Float?    @map("p50_latency")
  p95Latency         Float     @map("p95_latency")
  p99Latency         Float?    @map("p99_latency")
  errorRate          Float     @map("error_rate")
  totalRequestsSoFar Int?      @map("total_requests_so_far")
  successCount       Int?      @map("success_count")
  failureCount       Int?      @map("failure_count")

  @@index([loadTestId, relativeSeconds])
  @@map("load_test_samples")
}

// -------------------------------------------------------------
// API TESTER & COLLECTIONS
// -------------------------------------------------------------

model ApiCollection {
  id          String   @id @default(uuid())
  projectId   String   @map("project_id")
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name        String
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  requests SavedApiRequest[]

  @@index([projectId])
  @@map("api_collections")
}

model SavedApiRequest {
  id            String         @id @default(uuid())
  collectionId  String?        @map("collection_id")
  collection    ApiCollection? @relation(fields: [collectionId], references: [id], onDelete: SetNull)
  projectId     String         @map("project_id")
  project       Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  apiId         String?        @map("api_id")
  api           Api?           @relation(fields: [apiId], references: [id], onDelete: SetNull)
  environmentId String?        @map("environment_id")
  environment   Environment?   @relation(fields: [environmentId], references: [id], onDelete: SetNull)

  name          String
  description   String?
  method        HttpMethod     @default(GET)
  url           String
  headers       Json           @default("{}")
  queryParams   Json           @default("{}")
  body          String?
  bodyType      String         @default("json") @map("body_type")
  auth          Json           @default("{}")
  tests         Json           @default("[]")
  timeout       Int            @default(10000)

  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")

  @@index([projectId])
  @@index([collectionId])
  @@map("saved_api_requests")
}

model ApiRequestHistory {
  id             String       @id @default(uuid())
  projectId      String?      @map("project_id")
  project        Project?     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  apiId          String?      @map("api_id")
  api            Api?         @relation(fields: [apiId], references: [id], onDelete: SetNull)
  environmentId  String?      @map("environment_id")
  environment    Environment? @relation(fields: [environmentId], references: [id], onDelete: SetNull)

  method         HttpMethod
  url            String
  status         Int?
  statusText     String?      @map("status_text")
  durationMs     Float?       @map("duration_ms")
  sizeBytes      Int?         @map("size_bytes")
  error          String?
  requestSummary Json?        @map("request_summary")

  createdAt      DateTime     @default(now()) @map("created_at")

  @@index([projectId, createdAt(sort: Desc)])
  @@index([createdAt(sort: Desc)])
  @@map("api_request_histories")
}

