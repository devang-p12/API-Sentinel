# ==============================================================================
# API Sentinel Backend Environment Variables
# ==============================================================================

# Database connection (PostgreSQL - docker-compose maps port 5433:5432)
DATABASE_URL="postgresql://sentinel:sentinel_password@localhost:5433/sentinel_db?schema=public"

# Redis connection (Redis - docker-compose maps port 6380:6379)
REDIS_HOST="localhost"
REDIS_PORT=6380
# Optional: REDIS_URL or Upstash configuration
# REDIS_URL="redis://localhost:6380"
# UPSTASH_REDIS_REST_URL=""
# UPSTASH_REDIS_REST_TOKEN=""

# Application Port
PORT=3001

# Queue Worker Concurrency
MONITOR_WORKER_CONCURRENCY=10
ALERT_WORKER_CONCURRENCY=5

# ------------------------------------------------------------------------------
# Email Notifications
# Option A: Local Mailpit (included in docker-compose.yml on ports 1025 / 8025)
EMAIL_PROVIDER="smtp"
EMAIL_HOST="localhost"
EMAIL_PORT=1025
EMAIL_SECURE=false
EMAIL_FROM="sentinel@localhost"
EMAIL_USER=""
EMAIL_PASSWORD=""

# Option B: Direct Gmail SMTP
# EMAIL_PROVIDER="smtp"
# EMAIL_HOST="smtp.gmail.com"
# EMAIL_PORT=587
# EMAIL_USER="your-email@gmail.com"
# EMAIL_PASSWORD="your-app-password"
# EMAIL_FROM="your-email@gmail.com"

# Option C: Resend API (HTTP-based email delivery)
# EMAIL_PROVIDER="resend"
# RESEND_API_KEY="re_xxxxxxxxxxxx"
# EMAIL_FROM="onboarding@resend.dev"

# Secret Encryption (32-character key for encrypting webhook signing secrets)
# NOTIFICATION_ENCRYPTION_KEY="your-32-character-secret-encryption-key"

# ------------------------------------------------------------------------------
# API Tester & Webhook Security
API_TEST_MAX_TIMEOUT_MS=30000
API_TEST_MAX_RESPONSE_SIZE=10485760
API_TESTER_ALLOW_PRIVATE_IPS=true

# ------------------------------------------------------------------------------
# Load Testing (k6 Engine)
LOAD_TEST_MAX_VUS=500
LOAD_TEST_MAX_DURATION=3600
LOAD_TEST_MAX_REQUESTS=1000000
LOAD_TEST_WORKER_CONCURRENCY=2
# K6_BIN_PATH="/usr/local/bin/k6" # Path to k6 executable if not in system PATH

